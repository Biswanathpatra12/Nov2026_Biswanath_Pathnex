Kubernetes — Sidecar Container

apiVersion: v1
kind: pod

metadata:
  name: pathnex-Sidecar

spec:
  containers:
    - name: main
      image: nginx:latest
      ports:
        - containerPort: 80

      - name: Sidecar
        image: busybox:latest
        command: ['sh', '-c', 'echo Hello from sidecar && sleep 3600']


