Ansible Task — Install Nginx on Pathnex Server

---
- name: Install Nginx on pathnex server
  hosts: all
  become: yes

  tasks:
	- name: Install nginx
	ansible.buildin.yum:
		name:nginx
		state:present


Terraform Task — Create EC2 (c5.xlarge)


provider "aws" {
	region = "us-east-01"
}

resource "aws_instance" "PathnexEC2" {
	ami = "ami-0abcd1234"
	instance_type = "c5.large"

	tags = {
		Name = "Pathnex-EC2"
	}
}




Kubernetes Task — Create Nginx Pod

apiVersion: v1
kind: Pod

metadata:
	name: pathnex-pod

spec:
	containers:
		- name: web
		 image: nginx:latest
		 ports:
			- containerPort: 80


Shell Script — Print Date & Hostname

#!/bin/bash

echo "Date: $(date)"
echo "Hostname: $(hostname)"





Jenkins Pipeline — Checkout Git

pipeline {
	agent any
	
	stages {
		stage('Checkout') {
			steps {
				git branch :'main',
					url : 'github.com'
			}
		}
		stage('List File') {
			steps {
				sh 'ls-la'
			}
		}
	}
}





