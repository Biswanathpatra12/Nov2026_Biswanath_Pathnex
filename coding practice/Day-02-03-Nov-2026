  Kubernetes — Deployment with 2 Replicas


  apiVersion: apps/v1
  kind: Deployment

  metadata:
    name: PathnexWeb-deployment
  
  spec: 
    replicas: 2

    selector:
      matchLabels:
        app: pathnex-Server

    template:
      metadata:
        labels:
          app: pathnex-app

      spec:
        containers:
          - name: app
            image: nginx
            ports:
              - containersPort: 80


