Day 02 — Services & Tags
 Ansible — Install & Enable Nginx

 ---
 - name: Install and enable nginx on pathnex hosts
   hosts: all
   become: yes

   tasks:
    - name: Install nginx
      yum: 
        name: nginx
        state: present

    - name: start and enable nginx
      service:
        name: nginx
        state: started
        enabled: yes


