    GitLab CI — Maven Build

    stages:
      - build
      - test
      - package

      variables:
        MVN_OPT: "Dmaven.repos=.xyz"
      
      maven-build:
        stage: build
        image: maven:3.8.1-jdk-17
        script:
          - mvn clean compile
          artifacts:
           paths:
             - target/
          expire_in: 1 hour

      maven-test:
      stage: test
      image: maven:3.8.1-jdk-17
      script:
        - mvn test
        artifacts:
         paths:
           - target/
        expire_in: 1 hour

    maven-package:
        stage: package
        image: maven:3.8.1-jdk-17
        script:
            - mvn package
        artifacts:
            paths:
            - target/*.jar
          expire_in: 7 days