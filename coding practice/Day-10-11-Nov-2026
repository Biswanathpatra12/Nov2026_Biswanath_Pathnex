Jenkins Pipeline — Cache Maven Dependencies


pipeline {
    agent any

    environment {
        INSTITUTE_NAME = "Pathnex"
        MAVEN_OPTS = "-Dmaven.repo.local=$WORKSPACE/.m2/repository"
    }

    stages {

        stage('Checkout') {
            steps {
                git url: 'https://github.com/Pathnex/sample-java-app.git'
            }
        }

        stage('Build') {
            steps {
                sh '''
                    echo "Building application..."
                    mvn -B clean compile
                '''
            }
        }
    }
}


