Kubernetes — Rolling Update Strategy

apiVersion: app/v1
kind: Deployment

metadata:
  name: pathnex-Rolling

spec:
  replicas: 3

  strategy:
    type: RoolingUpdate
    roolingUpdate: 
      maxSurge: 1
      maxUnavailable: 1


    selector:
      matchLabels:
        app: roll

      template:
    metadata:
      labels:
        app: roll

    spec:
      containers:
        - name: web
          image: nginx:latest
          ports:
            - containerPort: 80

Shell Script — Backup Directory

#!/bin/bash

SOURCE="/var/log"
DEST="/backup/pathnex-$(date +%F).tar.gz"

mkdir -p /backup

tar -czf "$DEST" "$SOURCE"
if [ $? -eq 0 ]; then
    echo "Backup created successfully at: $DEST"
else
    echo "Backup failed!"
    exit 1
fi


Jenkins Pipeline — Multi-branch

pipeline {
    agent any

    environment {
        INSTITUTE_NAME = "Pathnex"
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
                echo "Checking out source code for ${env.BRANCH_NAME}"
            }
        }

        stage('Build') {
            steps {
                sh 'mvn clean compile'
            }
        }
    }
}

