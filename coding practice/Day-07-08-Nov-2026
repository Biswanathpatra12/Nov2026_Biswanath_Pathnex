Jenkins Pipeline — Parameterized

pipeline{
  agent any
  parameters{
      string(
          name: "Environment",
          defaultValue: "dev",
          description: "Deployment Environment"
      )
  }

  environment {
      INST_NAME = "Pathnex"
  }

  stages{
      stage('Checkout'){
        steps{
            git url: "https://github.com"
        }
      }
      stage('Deploy'){

        steps{

          sh 'echo Deploy via $Environment by $INST_NAME'
        }
      }
  }

}

